# Empty DATABASE_URL uses embedded PostgreSQL for local development.
DATABASE_URL=
DATABASE_DIR=.data/campusbite
PORT=5173
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
DEMO_PASSWORD=CampusBite123!

# DEMO simulates payment with no real money. Use LIVE only after merchant activation.
PAYMENT_MODE=DEMO
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
